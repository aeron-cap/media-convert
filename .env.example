# Copy to .env and adjust. All values are optional; defaults are shown.

# Port the app is published on (host side of docker compose).
PORT=8000

# How many conversions may run at the same time.
MAX_CONCURRENT_JOBS=2

# Converted files and their history entries are deleted after this many hours.
RETENTION_HOURS=24

# Reject videos longer than this. 0 disables the limit.
MAX_DURATION_MINUTES=180

# Maximum number of entries accepted from one playlist.
MAX_PLAYLIST_ITEMS=50
