# Copy to .env and adjust. All values are optional; defaults are shown.

# Port the app is published on (host side of docker compose).
PORT=6969

# How many conversions may run at the same time.
MAX_CONCURRENT_JOBS=2

# Converted files and their history entries are deleted after this many hours.
RETENTION_HOURS=24

# Reject videos longer than this. 0 disables the limit.
MAX_DURATION_MINUTES=180

# Maximum number of entries accepted from one playlist.
MAX_PLAYLIST_ITEMS=50

# Most conversions that may be waiting or running at once; more are refused
# until some finish. 0 disables the limit.
MAX_PENDING_JOBS=100

# --- Staying under YouTube's bot checks (see the README). The two pacing settings also apply to TikTok. ---

# Minimum seconds between two metadata fetches, across all jobs and both sites. 0 disables.
YT_MIN_INTERVAL_SECONDS=2

# Seconds yt-dlp waits between its own requests while fetching metadata.
YT_REQUEST_SLEEP_SECONDS=0.5

# How many times a job retries when YouTube answers with its bot check.
YT_RETRIES=2

# Send all YouTube traffic through a proxy, e.g. one on your home connection.
# YT_PROXY=socks5://10.0.0.2:1080

# PO token provider. Also start it: docker compose --profile pot up -d
# YT_POT_PROVIDER_URL=http://pot-provider:4416
